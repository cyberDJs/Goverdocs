{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goverdocs.local/schemas/documentation-decision-rule.schema.json",
  "title": "GOVERDOCS decision matrix",
  "type": "object",
  "required": [
    "version",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "event",
          "description",
          "severity",
          "priority",
          "actions",
          "validations",
          "approval",
          "rollback",
          "on_failure"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DOC-EVT-\\d{3}$"
          },
          "event": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 3
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "document_type",
                "action",
                "target",
                "write_policy"
              ]
            }
          },
          "validations": {
            "type": "array"
          },
          "approval": {
            "type": "object",
            "required": [
              "required",
              "roles"
            ]
          },
          "rollback": {
            "type": "object"
          },
          "on_failure": {
            "type": "object"
          }
        }
      }
    }
  }
}
