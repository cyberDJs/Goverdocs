{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goverdocs.local/schemas/document-metadata.schema.json",
  "title": "GOVERDOCS document metadata",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "owner",
    "created",
    "updated",
    "version",
    "canonical",
    "managed_by",
    "write_policy",
    "related",
    "source_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
    },
    "type": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "in-review",
        "accepted",
        "active",
        "blocked",
        "completed",
        "rejected",
        "cancelled",
        "deprecated",
        "superseded",
        "archived"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "canonical": {
      "type": "boolean"
    },
    "managed_by": {
      "enum": [
        "human",
        "agent",
        "mixed"
      ]
    },
    "write_policy": {
      "enum": [
        "automatic",
        "append-only",
        "approval-required",
        "immutable",
        "generated"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "review_due": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  },
  "additionalProperties": true
}
