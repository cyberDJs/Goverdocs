{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goverdocs.local/schemas/approval.schema.json",
  "title": "GOVERDOCS Approval v1",
  "type": "object",
  "required": ["schema_version", "approval_id", "rule_id", "approval_type", "decision", "actor", "subject", "approved_at", "source", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "approval_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "approval_type": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approved", "denied", "revoked"]},
    "actor": {
      "type": "object",
      "required": ["provider", "id", "role"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["repository", "pull_request", "head_sha", "change_digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 3},
        "pull_request": {"type": "integer", "minimum": 1},
        "head_sha": {"$ref": "#/$defs/gitSha"},
        "change_digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "approved_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "external_id": {"type": ["string", "integer"]}
      },
      "additionalProperties": false
    },
    "verification": {"$ref": "#/$defs/verification"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verification": {
      "type": "object",
      "required": ["status", "verifier_id", "method", "verified_at", "valid_until"],
      "properties": {
        "status": {"enum": ["verified", "unverified", "rejected"]},
        "verifier_id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
