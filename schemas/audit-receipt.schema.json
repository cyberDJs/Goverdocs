{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "created_at",
    "command",
    "root",
    "result"
  ],
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "draft-generated"
      ]
    }
  }
}
