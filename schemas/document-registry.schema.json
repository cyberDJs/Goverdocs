{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document registry",
  "type": "object",
  "required": [
    "generated_at",
    "documents"
  ],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "type",
          "status",
          "canonical"
        ]
      }
    }
  }
}
