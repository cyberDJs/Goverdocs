{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goverdocs.local/schemas/gate-report.schema.json",
  "title": "GOVERDOCS GateReport R1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "evaluation_date",
    "input",
    "policy_digests",
    "events",
    "obligations",
    "validation_issues",
    "evidence_gaps",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": ["PASS", "WARN", "BLOCKED"]
    },
    "evaluation_date": {
      "type": "string",
      "format": "date"
    },
    "input": {
      "type": "object",
      "required": ["digest", "changed_files"],
      "properties": {
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "policy_digests": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "validation_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationIssue"
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceGap"
      }
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event": {
      "type": "object",
      "required": ["name", "confidence", "reasons"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": [
        "event",
        "rule_id",
        "document_type",
        "action",
        "target",
        "write_policy",
        "approval_required",
        "severity",
        "priority"
      ],
      "properties": {
        "event": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "document_type": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "write_policy": {"type": "string", "minLength": 1},
        "approval_required": {"type": "boolean"},
        "severity": {"type": "string", "minLength": 1},
        "priority": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": [
        "event",
        "rule_id",
        "severity",
        "priority",
        "required_evidence",
        "approval_required",
        "approval_roles",
        "actions"
      ],
      "properties": {
        "event": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "priority": {"type": "integer"},
        "required_evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "approval_required": {"type": "boolean"},
        "approval_roles": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/operation"}
        }
      },
      "additionalProperties": false
    },
    "validationIssue": {
      "type": "object",
      "required": ["severity", "code", "path", "message"],
      "properties": {
        "severity": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidenceGap": {
      "type": "object",
      "required": ["code", "severity", "blocking", "subject", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "subject": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
